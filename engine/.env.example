# ─────────────────────────────────────────────────────────────
# Simona Engine 配置说明（示例文件）
#
# 实际的 .env 由上级程序（bridge-server.cjs）在打包/运行时提供，
# 本文件仅作为配置项文档。复制为 .env 后按需修改。
# 注意：不要在 .env 中设置 SIMONA_API_KEY / SIMONA_BASE_URL ——
# 它们由 bridge-server 在 spawn 引擎子进程时通过环境变量注入。
# ─────────────────────────────────────────────────────────────

# 默认模型
SIMONA_MODEL=simona-sonnet-4-6
SIMONA_DEFAULT_SONNET_MODEL=simona-sonnet-4-6
SIMONA_DEFAULT_HAIKU_MODEL=simona-haiku-4-5-20251001
SIMONA_DEFAULT_OPUS_MODEL=simona-opus-4-6

# API 超时（毫秒）
API_TIMEOUT_MS=300000

# 关闭遥测与非必要网络流量
DISABLE_TELEMETRY=1
SIMONA_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# 禁用扩展思考（工具型 agent，避免模型把解答写进 thinking 后空输出）
SIMONA_CODE_DISABLE_THINKING=1

# 第三方模型上下文窗口覆盖（默认 200K，可按模型能力调大）
SIMONA_CODE_MODEL_CONTEXT_WINDOW=1000000

# GitHub OAuth（可选，用于 GitHub Integration）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

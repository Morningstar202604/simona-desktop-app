{
    "appId":  "com.simona.desktop",
    "productName":  "Simona Desktop",
    "asar":  true,
    "directories":  {
                        "output":  "release"
                    },
    "files":  [
                  "dist/**/*",
                  "electron/**/*",
                  "!**/node_modules/@fontsource*/**/*",
                  "!**/node_modules/react*/**/*",
                  "!**/node_modules/recharts/**/*",
                  "!**/node_modules/mermaid/**/*",
                  "!**/node_modules/katex/**/*",
                  "!**/node_modules/lucide-react/**/*",
                  "!**/node_modules/react-markdown/**/*",
                  "!**/node_modules/react-router*/**/*",
                  "!**/node_modules/react-syntax-highlighter/**/*",
                  "!**/node_modules/rehype*/**/*",
                  "!**/node_modules/remark*/**/*",
                  "!**/node_modules/hast*/**/*",
                  "!**/node_modules/mdast*/**/*",
                  "!**/node_modules/unified/**/*",
                  "!**/node_modules/vfile/**/*",
                  "!**/node_modules/micromark*/**/*",
                  "!**/node_modules/devlop/**/*",
                  "!**/node_modules/decode-named-character-reference/**/*",
                  "!**/node_modules/d3*/**/*",
                  "!**/node_modules/@types/**/*"
              ],
    "extraFiles":  [
                       {
                           "from":  "engine",
                           "to":  "resources/engine",
                           "filter":  [
                                          "**/*",
                                          "!node_modules.rar",
                                          "!node_modules/.cache/**/*",
                                          "!node_modules/@types/**/*",
                                          "!**/*.map"
                                      ]
                       },
                       {
                           "from":  "engine/node_modules",
                           "to":  "resources/engine/node_modules",
                           "filter":  [
                                          "**/*",
                                          "!**/.cache/**/*",
                                          "!**/@types/**/*",
                                          "!**/*.map"
                                      ]
                       },
                       {
                           "from":  "git-bundle",
                           "to":  "resources/git",
                           "filter":  [
                                          "**/*"
                                      ]
                       },
                       {
                           "from":  "agent-relay.cjs",
                           "to":  "agent-relay.cjs"
                       },
                       {
                           "from":  "get-email.ps1",
                           "to":  "get-email.ps1"
                       },
                       {
                           "from":  "启动程序.bat",
                           "to":  "启动程序.bat"
                       }
                   ],
    "extraResources":  [
                           {
                               "from":  "providers.json",
                               "to":  "providers.json"
                           },
                           {
                               "from":  "公网访问-一键启�?bat",
                               "to":  "公网访问-一键启�?bat"
                           },
                           {
                               "from":  "INSTALL_README.md",
                               "to":  "INSTALL_README.md"
                           },
                           {
                               "from":  "快速开�?md",
                               "to":  "快速开�?md"
                           }
                       ],
    "publish":  {
                    "provider":  "github",
                    "owner":  "y1s11564",
                    "repo":  "simona-desktop-app"
                },
    "win":  {
                "target":  [
                               "dir"
                           ],
                "icon":  "public/favicon.ico",
                "asarUnpack":  [
                                   "resources/engine/**/*",
                                   "resources/git/**/*"
                               ]
            },
    "mac":  {
                "target":  [
                               "dmg",
                               "zip"
                           ],
                "icon":  "public/icon-mac.png",
                "category":  "public.app-category.productivity"
            },
    "linux":  {
                  "target":  [
                                 "AppImage",
                                 "deb"
                             ],
                  "icon":  "public/favicon.png",
                  "category":  "Utility"
              },
    "nsis":  {
                 "oneClick":  true,
                 "perMachine":  false,
                 "deleteAppDataOnUninstall":  false,
                 "createDesktopShortcut":  true,
                 "createStartMenuShortcut":  true,
                 "shortcutName":  "Simona Desktop"
             }
}
